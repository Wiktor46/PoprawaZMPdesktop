<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ZMPdesktop.ViewModels"
             xmlns:m="using:ZMPdesktop.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ZMPdesktop.Views.UsersView"
             x:DataType="vm:UsersViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header Toolbar -->
        <Border Grid.Row="0" Background="#2B2B3D" Padding="16,12" CornerRadius="8" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Filter Tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Filtruj użytkowników:" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox SelectedIndex="{Binding FilterIndex}" Width="160" Height="36" CornerRadius="6" VerticalAlignment="Center">
                        <ComboBoxItem Content="Wszyscy"/>
                        <ComboBoxItem Content="Tylko On-line"/>
                        <ComboBoxItem Content="Tylko Off-line"/>
                    </ComboBox>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="➕ Rejestruj czytelnika Off-line" 
                            Command="{Binding OpenAddDialogCommand}" 
                            Background="#6C5CE7" Foreground="White" CornerRadius="6" Height="36" Padding="14,6" FontWeight="SemiBold"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center"/>

                    <Button Content="🔄 Odśwież" 
                            Command="{Binding LoadDataCommand}" 
                            Background="#3F3F56" Foreground="White" CornerRadius="6" Height="36" Padding="14,6"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <!-- Users List -->
            <Border Grid.Column="0" Background="#2B2B3D" CornerRadius="8" Padding="12">
                <ListBox ItemsSource="{Binding Users}" 
                         SelectedItem="{Binding SelectedUser}" 
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="m:UserModel">
                            <Border Padding="12" Margin="0,2" Background="#1E1E2E" CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Foreground="White"/>
                                            <Border CornerRadius="4" Padding="6,2" 
                                                    Background="{Binding IsOffline, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Text="{Binding UserTypeBadge}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Email, StringFormat='Identyfikator/E-mail: {0}'}" Foreground="#B0B0C0" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{Binding Role, StringFormat='Rola: {0}'}" FontSize="12" Foreground="#00CEC9" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Zarejestrowany: {0:dd.MM.yyyy}'}" FontSize="11" Foreground="#808090"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Slide-over Add Form Dialog -->
            <Border Grid.Column="1" 
                    Width="340" 
                    Background="#2B2B3D" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="12,0,0,0" 
                    IsVisible="{Binding IsAddDialogVisible}">
                <StackPanel Spacing="14">
                    <TextBlock Text="👤 Rejestracja Czytelnika Off-line" FontSize="17" FontWeight="Bold" Foreground="#6C5CE7"/>
                    
                    <StackPanel Spacing="4">
                        <TextBlock Text="Imię i Nazwisko czytelnika:" Foreground="#DCDCF0" FontSize="12"/>
                        <TextBox Text="{Binding NewFullName}" Watermark="Jan Kowalski" CornerRadius="6" Height="36"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Opcjonalny adres E-mail / kontakt:" Foreground="#DCDCF0" FontSize="12"/>
                        <TextBox Text="{Binding NewEmail}" Watermark="kowalski@przyklad.pl (opcjonalnie)" CornerRadius="6" Height="36"/>
                    </StackPanel>

                    <TextBlock Text="Czytelnik off-line wypożycza pozycje wyłącznie na miejscu w bibliotece bez rejestracji konta internetowego." 
                               Foreground="#A0A0B0" FontSize="11" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                        <Button Content="Anuluj" Command="{Binding CancelAddDialogCommand}" Background="#3F3F56" CornerRadius="6" Padding="12,6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button Content="Zarejestruj" Command="{Binding SaveOfflineUserCommand}" Background="#6C5CE7" Foreground="White" CornerRadius="6" FontWeight="SemiBold" Padding="12,6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#1E1E2E" Padding="12,6" Margin="0,8,0,0" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#A0A0B0" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
