<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ZMPdesktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ZMPdesktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid Background="#1E1E2E">
        <!-- Main Card Container -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Width="420" 
                Background="#2B2B3D" 
                CornerRadius="16" 
                Padding="32" 
                BoxShadow="0 8 24 0 #33000000">
            
            <StackPanel Spacing="20">
                <!-- Header -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="📖 Panel Bibliotekarza" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="System Zarządzania Biblioteką (Multi-Client)" 
                               FontSize="13" 
                               Foreground="#A0A0B0" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <Separator Background="#3F3F56" Margin="0,4,0,4"/>

                <!-- Email -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Adres E-mail bibliotekarza:" Foreground="#DCDCF0" FontSize="12"/>
                    <TextBox Text="{Binding Email}" 
                             Watermark="admin@library.com" 
                             Height="40" 
                             CornerRadius="8"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Hasło:" Foreground="#DCDCF0" FontSize="12"/>
                    <TextBox x:Name="PasswordBox" 
                             PasswordChar="*" 
                             Height="40" 
                             CornerRadius="8"/>
                </StackPanel>

                <!-- Error Alert -->
                <Border Background="#4A1E24" 
                        BorderBrush="#E74C3C" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="12" 
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="#FFB3B3" 
                               FontSize="12" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Login Button -->
                <Button Content="{Binding IsBusy, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue='Zaloguj do panelu'}"
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding #PasswordBox.Text}"
                        IsEnabled="{Binding !IsBusy}"
                        Background="#6C5CE7" 
                        Foreground="White" 
                        FontWeight="SemiBold" 
                        Height="44" 
                        CornerRadius="8" 
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,8,0,0"/>

                <!-- Footer Hint -->
                <TextBlock Text="Domyślne konto: admin@library.com" 
                           FontSize="11" 
                           Foreground="#707085" 
                           HorizontalAlignment="Center" 
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>